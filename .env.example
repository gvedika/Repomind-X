# --- Core retrieval (all that the CPU demo needs) --------------------------------------------
# Where materialized repository snapshots and per-commit indexes (.repomind/) are stored.
REPOSITORY_ROOT=./data/repos
# "memory" runs without Neo4j. "neo4j" uses the services below and falls back to memory
# (with a warning) when Neo4j is unreachable and ALLOW_GRAPH_FALLBACK=true.
GRAPH_BACKEND=memory
ALLOW_GRAPH_FALLBACK=true
MODEL_DEVICE=cpu
EMBEDDING_MODEL=Alibaba-NLP/gte-modernbert-base
EMBEDDING_QUERY_INSTRUCTION=
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATES=50
RERANK_CANDIDATES=30

# --- Optional services (docker compose full stack) ---------------------------------------------
# Leave CHROMA_HOST empty to skip Chroma; the local index is always used for /api/search.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
CHROMA_HOST=
CHROMA_PORT=8000
MLFLOW_TRACKING_URI=

# --- Optional LLM explanation (not required for retrieval) ------------------------------------
# openai | anthropic | local
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0
ENABLE_LLM_REASONING=false
MCP_SERVER_COMMAND=python -m app.mcp_server.server
